#!/bin/sh
# Network driver activator

echo "=== Network Driver Activator ==="
echo "1) e1000"
echo "2) virtio_net"
echo "3) Both"
echo -n "Seçiminiz (1-3): "
read choice

case $choice in
    1)
        modprobe e1000
        echo "✅ e1000 loaded"
        ip link set eth0 up
        udhcpc -i eth0
        ;;
    2)
        modprobe virtio_net
        echo "✅ virtio_net loaded"
        ip link set eth0 up
        udhcpc -i eth0
        ;;
    3)
        modprobe e1000
        modprobe virtio_net
        echo "✅ Both drivers loaded"
        ip link set eth0 up
        udhcpc -i eth0
        ;;
    *)
        echo "❌ Invalid choice"
        exit 1
        ;;
esac

echo "🎉 Network is ready!"
